<?xml version="1.0" encoding="utf-8" ?>
<?xml-model href="../../Organization/knxprod-support/knx_project_20/knx-editor.xsd" type="application/xml" schematypens="http://www.w3.org/2001/XMLSchema"?>
<KNX xmlns="http://knx.org/xml/project/20" xmlns:op="http://github.com/OpenKNX/OpenKNXproducer">

  <op:config name="%NET_IPConfigTool%" value="1" />
  <op:config name="%Tunnelcount%" value="16" />
  <op:config name="%NET_ServiceNTP%" value="1" />
  <op:config name="%NET_ServiceHTTP%" value="1" />
  <op:config name="%NET_LanMode%" value="1" />

  <op:config name="%BASE_Info1LedLabel%" value=" (N/A)"></op:config>
  <op:config name="%BASE_Info2LedLabel%" value=" (IP)"></op:config>
  <op:config name="%BASE_Info3LedLabel%" value=" (KNX)"></op:config>
  <op:config name="%BASE_Info1LedFunc%" value="0"></op:config>
  <op:config name="%BASE_Info2LedFunc%" value="10"></op:config>
  <op:config name="%BASE_Info3LedFunc%" value="3"></op:config>
  <op:config name="%BASE_Info1LedFunc_Access%" value="ReadWrite"></op:config>
  <op:config name="%BASE_Info2LedFunc_Access%" value="ReadWrite"></op:config>
  <op:config name="%BASE_Info3LedFunc_Access%" value="ReadWrite"></op:config>
  
  <op:nowarn id="1" regex="%BASE_" />
  <op:nowarn id="3" regex="BASE_getUnsupportedEtsModules" />

  <!-- OrderNumber: the XSD allows 50 characters, but the DEVICE carries it in PID_ORDER_INFO, which is
       PDT_GENERIC_10, so exactly 10 bytes. Anything longer is silently truncated there, and `ftc info`
       then shows something else than ETS: "OpenKnxIPRouter" arrives as "OpenKnxIPR",
       "OpenKnxRaumController" as "OpenKnxRau". Keep it at 10 or fewer and spend those characters on the
       product name; manufacturer and OpenKnxId are already carried by PID_MANUFACTURER_ID and
       PID_HARDWARE_TYPE. -->
  <op:ETS OpenKnxId="0xA1" 
          ApplicationNumber="31" 
          ApplicationVersion="0.7" 
          ReplacesVersionsDownTo="0.1" 
          ApplicationRevision="0" 
          ProductName="IP-Router" 


          SerialNumber="0xA100"
          OrderNumber="IP-Router"
          ApplicationName="IP-Router"
          IsRailMounted="true"
          BusCurrent="30"
          MaskVersion="MV-091A"
          />

  <op:define prefix="BASE" ModuleType="10" >
    <op:verify File="../lib/OGM-Common/library.json" ModuleVersion="1.9" />
  </op:define>
  <op:define prefix="NET" ModuleType="11" share="../lib/OFM-Network/src/Network.share.xml" >
    <op:verify File="../lib/OFM-Network/library.json" ModuleVersion="0.8" />
  </op:define>
  <!-- FTC access-control config. Pulled because this product builds with -D OPENKNX_FTC_SECURITY; the share
       carries 0 ComObjects, so the router stays KO-free. ModuleType 13 (10/11/99 taken). -->
  <op:define prefix="FTM" ModuleType="13" share="../lib/OFM-FileTransferModule/src/FileTransfer.share.xml" />
  <op:define prefix="ROUTE" NumChannels="%Tunnelcount%" ModuleType="99" share="IP-Router.share.xml" template="IP-Router.templ.xml" />

  <generate base="TemplateRouter.xml"/>

</KNX>